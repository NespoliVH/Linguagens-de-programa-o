def nivel2_consulta_ceps():
    """Exercício 2.1: consulta vários CEPs no ViaCEP e monta um DataFrame."""
    print("\n=== NÍVEL 2.1: Consulta de CEPs (ViaCEP) ===")

    ceps = ["01310-100", "20040-020", "70150-900"]  # Av. Paulista, Rio, Brasília
    resultados = []

    for cep in ceps:
        cep_limpo = cep.replace("-", "").replace(".", "")
        url = f"https://viacep.com.br/ws/{cep_limpo}/json/"
        try:
            resposta = requests.get(url, timeout=10)
            resposta.raise_for_status()
            dados = resposta.json()
            if "erro" in dados:
                print(f"CEP {cep} não encontrado.")
                continue
            resultados.append(dados)
        except requests.exceptions.RequestException as erro:
            print(f"Falha ao consultar o CEP {cep}: {erro}")

        time.sleep(0.3)  # pequena pausa entre requisições, por boas práticas

    df_ceps = pd.DataFrame(resultados)
    if not df_ceps.empty:
        print(df_ceps[["cep", "logradouro", "bairro", "localidade", "uf"]])
    return df_ceps


def nivel2_download_seguro(url, caminho_arquivo):
    """Exercício 2.2: função de download com tratamento de erros."""
    try:
        resposta = requests.get(url, timeout=10)
        resposta.raise_for_status()
    except requests.exceptions.HTTPError as erro_http:
        print(f"Erro HTTP ao baixar {url}: {erro_http}")
        return False
    except requests.exceptions.RequestException as erro:
        print(f"Falha de conexão ao baixar {url}: {erro}")
        return False

    with open(caminho_arquivo, "wb") as arquivo:
        arquivo.write(resposta.content)

    print(f"Download concluído: {caminho_arquivo}")
    return True


def nivel2_download_imagem():
    """Exercício 2.3: baixa uma imagem aleatória do Picsum Photos."""
    print("\n=== NÍVEL 2.3: Download de imagem ===")
    url_imagem = "https://picsum.photos/400/400"
    caminho = "imagem_aleatoria.jpg"
    nivel2_download_seguro(url_imagem, caminho)

