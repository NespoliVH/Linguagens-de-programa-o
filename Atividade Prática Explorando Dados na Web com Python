def nivel3_verificar_robots(url_base):
    """Exercício 3.1: verifica o robots.txt antes de fazer scraping."""
    print("\n=== NÍVEL 3.1: Verificação do robots.txt ===")
    url_robots = url_base.rstrip("/") + "/robots.txt"
    try:
        resposta = requests.get(url_robots, timeout=10)
        resposta.raise_for_status()
        print(f"Conteúdo de {url_robots}:\n")
        print(resposta.text)
    except requests.exceptions.RequestException as erro:
        print(f"Não foi possível obter o robots.txt: {erro}")


def nivel3_scraping_livros():
    """Exercícios 3.2 e 3.3: extrai os 5 primeiros livros de books.toscrape.com."""
    print("\n=== NÍVEL 3.2/3.3: Scraping de livros ===")
    url = "https://books.toscrape.com/"
    cabecalhos = {"User-Agent": "AtividadePython-EstudosWeb/1.0"}

    resposta = requests.get(url, headers=cabecalhos, timeout=10)
    resposta.raise_for_status()

    sopa = BeautifulSoup(resposta.text, "html.parser")
    livros = sopa.select("article.product_pod")[:5]

    dados_livros = []
    for livro in livros:
        titulo = livro.h3.a["title"]
        preco = livro.select_one("p.price_color").get_text(strip=True)
        dados_livros.append({"titulo": titulo, "preco": preco})

    df_livros = pd.DataFrame(dados_livros)
    print(df_livros)

    # 3.3: salvar em CSV
    caminho_csv = "livros_top5.csv"
    df_livros.to_csv(caminho_csv, index=False, encoding="utf-8-sig")
    print(f"Dados salvos em: {caminho_csv}")

    return df_livros


def nivel3_tabela_wikipedia():
    """Exercício 3.4: extrai uma tabela da Wikipedia com pandas.read_html()."""
    print("\n=== NÍVEL 3.4: Tabela da Wikipedia ===")
    url = "https://en.wikipedia.org/wiki/List_of_countries_by_population_(United_Nations)"
    cabecalhos = {"User-Agent": "AtividadePython-EstudosWeb/1.0"}

    resposta = requests.get(url, headers=cabecalhos, timeout=10)
    resposta.raise_for_status()

    tabelas = pd.read_html(io.StringIO(resposta.text))
    # A primeira tabela grande costuma ser a de interesse; se a estrutura da
    # página mudar, ajuste o índice ou filtre pelas colunas esperadas.
    df_populacao = tabelas[0]
    print(df_populacao.head(10))

    return df_populacao


