def nivel1_requisicao_basica():
    """Exercícios 1.1 a 1.4."""
    print("\n=== NÍVEL 1: Requisição básica ===")

    url = "https://jsonplaceholder.typicode.com/posts"

    # 1.2: parâmetro de filtro (userId=2)
    parametros = {"userId": 2}

    # 1.3: cabeçalho customizado com User-Agent
    cabecalhos = {
        "User-Agent": "AtividadePython-EstudosWeb/1.0 (contato@exemplo.com)"
    }

    resposta = requests.get(
        url,
        params=parametros,
        headers=cabecalhos,
        timeout=10,
    )

    # 1.4: status code e URL final montada pelo requests
    print("Status code:", resposta.status_code)
    print("URL final:", resposta.url)

    if resposta.status_code == 200:
        dados = resposta.json()
        print(f"Total de posts retornados para userId=2: {len(dados)}")
        if dados:
            print("Exemplo de post:", dados[0]["title"])

    return resposta

